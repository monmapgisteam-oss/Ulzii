# ─────────────────────────────────────────────────────────────
# ArcGIS Feature Service-ийн нэвтрэлтийн тохиргоо
# Энэ файлыг .env.local нэрээр хуулж, өөрийн мэдээллээ бөглөнө.
# Токен зөвхөн серверт ашиглагдах бөгөөд хөтөч рүү дамжихгүй.
# ─────────────────────────────────────────────────────────────

# 1) Хамгийн энгийн: ArcGIS Online хэрэглэгчийн нэр, нууц үг
ARCGIS_USERNAME=
ARCGIS_PASSWORD=

# 2) Эсвэл OAuth 2.0 хэрэглээний (application) итгэмжлэл
# ARCGIS_CLIENT_ID=
# ARCGIS_CLIENT_SECRET=

# 3) Эсвэл гараар үүсгэсэн бэлэн токен
# ARCGIS_TOKEN=

# Төслийн FeatureServer хаягийг өөрчлөх шаардлагатай бол (анхдагч утга кодод бий)
# ARCGIS_RANGELAND_SERVICE_URL=

# Нэмэлт (шаардлагатай үед)
# ARCGIS_PORTAL_URL=https://www.arcgis.com
# ARCGIS_REFERER=http://localhost:3000
# ARCGIS_SERVICE_URL=https://services-ap1.arcgis.com/fwC6eN4IwtqH3A7R/arcgis/rest/services/service_99d12031bc274b73af81b5e00b05d63f/FeatureServer
